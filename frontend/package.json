        "react-toastify": "11.0.5",
        "shared": "*"
    },
    "devDependencies": {
        "@eslint/js": "^9.33.0",
        "@hookform/resolvers": "5.2.2",
        "@types/node": "^24.3.1",
        "@types/react": "^19.1.10",
        "@types/react-dom": "^19.1.7",
        "@vitejs/plugin-react": "^5.0.2",
        "eslint": "^9.33.0",
        "eslint-plugin-jsx-a11y": "6.10.2",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hooks": "5.2.0",
