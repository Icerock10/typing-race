FROM node:22-alpine
WORKDIR /app

COPY package*.json ./
COPY tsconfig.json ./
COPY shared/package.json ./shared/
COPY backend/package.json ./backend/

RUN npm ci

COPY shared/ ./shared/
RUN cd shared && npm run build

COPY backend/ ./backend/
WORKDIR /app/backend
RUN npm run build

CMD ["node", "build/index.js"]
