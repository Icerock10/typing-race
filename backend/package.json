{
    "name": "backend",
    "type": "module",
    "version": "1.0.0",
    "engines": {
        "node": "22.x.x",
        "npm": "10.x.x"
    },
    "scripts": {
        "lint:type": "npx tsc --noEmit",
        "lint:js": "npx eslint . --max-warnings=0",
        "seeds:run": "tsx src/db/seeds/database-seeds.ts",
        "lint": "npm run lint:type && npm run lint:js",
        "start:dev": "tsx watch src/index.ts",
        "build": "tsc && tsc-alias && npm run build:copy",
        "build:copy": "cp -r package.json build",
        "start": "node ./src/index.js"
    },
    "dependencies": {
        "@fastify/oauth2": "8.2.0",
        "@fastify/static": "8.2.0",
        "@typegoose/typegoose": "12.19.0",
        "bcrypt": "6.0.0",
        "convict": "^6.2.4",
        "dotenv": "^17.2.0",
        "fastify": "^5.6.0",
        "fastify-plugin": "5.0.1",
        "jose": "6.1.0",
        "mongoose": "^8.18.1",
        "pino": "^9.7.0",
        "pino-pretty": "^13.0.0",
        "shared": "*",
        "socket.io": "4.8.3"
    },
    "devDependencies": {
        "@types/bcrypt": "6.0.0",
        "@types/convict": "^6.1.6",
        "ts-node": "^10.9.2",
        "tsx": "^4.20.3"
    }
}
